generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = "postgres://e77af2969ec6b430c3e2647ee6d54e264d216d444dadf07d1a5cc4145a9e479a:sk_eQCHe7i7Cgk1UutdaBixM@db.prisma.io:5432/postgres?sslmode=require"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  password    String
  createdAt   DateTime @default(now())
  trips       TripMember[]
}

model Trip {
  id          String       @id @default(uuid())
  title       String
  destination String?
  startDate   DateTime
  endDate     DateTime
  status      String       @default("draft")
  currency    String       @default("TWD")
  createdBy   String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     TripMember[]
}

model TripMember {
  id       String @id @default(uuid())
  tripId   String
  userId   String
  role     String @default("member")
  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
}